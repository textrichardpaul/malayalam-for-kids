{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "ca.worksmarthq.malayalamforkids",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "7ae3f282-c5b1-4723-a7f5-686df68dcac2"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "ca.worksmarthq.malayalamforkids",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Allow microphone access so your child can record their Malayalam practice. Recordings stay on this device."
      },
      "supportsTablet": true
    },
    "name": "Malayalam for Kids",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "microphonePermission": "Allow microphone access so your child can record their Malayalam practice. Recordings stay on this device."
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": []
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7c3aed",
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "slug": "malayalam-for-kids",
    "userInterfaceStyle": "light",
    "version": "1.0.0"
  }
}
